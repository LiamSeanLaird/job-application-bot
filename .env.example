# Copy to .env and fill in. Git ignores .env.

# Required: OpenAI API key for fit checks, duplicate checks and reading job alert emails.
OPENAI_KEY=
# Optional: override the model.
# OPENAI_MODEL=gpt-6-luna

# Optional: JSearch (Google for Jobs) key from openwebninja.com. Leave empty to skip JSearch.
JSEARCH_API_KEY=

# Server for deploy/deploy.sh: an Ubuntu machine you can SSH into, with sudo, nginx and certbot.
DEPLOY_HOST=ubuntu@203.0.113.10
# Optional: SSH key for that server. Leave empty to use your normal SSH setup.
DEPLOY_SSH_KEY=
# Optional: the web app's hostname. Leave empty to use a free sslip.io name made from the server's IP.
APP_HOSTNAME=
# Optional: the web app's login name. The first deploy generates WEB_PASSWORD and adds it here.
WEB_USERNAME=
